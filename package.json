{
	"name": "n8n-nodes-blocos",
	"version": "0.2.1",
	"description": "Nós do n8n para a Blocos Marketing: negócios, clientes, tarefas, planos de ação, relatórios e métricas, mais um gatilho para os eventos da plataforma.",
	"license": "MIT",
	"homepage": "https://github.com/Analista-Moderno/n8n-nodes-blocos#readme",
	"keywords": [
		"n8n-community-node-package",
		"blocos",
		"blocos-marketing",
		"marketing-agency"
	],
	"author": {
		"name": "Blocos Marketing",
		"email": "leonardomanoha@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Analista-Moderno/n8n-nodes-blocos.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/BlocosApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Blocos/Blocos.node.js",
			"dist/nodes/BlocosTrigger/BlocosTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
